{
  "name": "stageplot",
  "version": "0.0.0",
  "private": true,
  "description": "Build stage plots and technical riders for live music.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @stageplot/web",
    "dev:api": "npm run dev --workspace @stageplot/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:push": "npm run db:push --workspace @stageplot/api"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "prisma@6.19.3": true
  }
}
