# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL="file:./dev.db"
PORT=3001

# At least 32 random characters. Required in production (the server refuses to
# start with the dev default when NODE_ENV=production).
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Comma-separated web origins allowed to send state-changing auth requests
# (CSRF defence alongside the SameSite=Lax session cookie).
WEB_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Optional: where the PDF renderer finds the print view and Chrome.
# PRINT_URL="http://localhost:5173/print"
# CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
